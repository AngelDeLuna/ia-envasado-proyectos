# Puerto local. Railway asigna PORT automáticamente.
PORT=3000

# Opción A: variables MySQL separadas
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=TU_PASSWORD
MYSQLDATABASE=ia_envasado

# Opción B: una URL completa. Si existe, tiene prioridad sobre las variables de arriba.
# MYSQL_URL=mysql://usuario:password@host:3306/base_de_datos


# Railway/Aiven suelen requerir SSL. Pon true si tu proveedor lo indica.
MYSQL_SSL=false
